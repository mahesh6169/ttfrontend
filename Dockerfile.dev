# Local development image, used only by compose.yaml.
# Prod does NOT use this file: Vercel builds the app itself.
# Same Node as the backend's prod image.
FROM node:22.7.0

WORKDIR /app

# Pre-create the dirs that become named volumes so they are owned by the
# "node" user (uid 1000), not root. Source code is bind-mounted at runtime.
RUN mkdir -p /app/node_modules /app/.next && chown -R node:node /app

USER node

EXPOSE 3020

# package-lock.json is gitignored in this repo: use it (npm ci) when present,
# otherwise npm install (fresh clone). Reinstall only when it changes.
CMD ["sh", "-c", "if [ -f package-lock.json ]; then h=$(sha1sum package-lock.json | cut -d' ' -f1); [ \"$(cat node_modules/.lockhash 2>/dev/null)\" = \"$h\" ] || { npm ci && echo \"$h\" > node_modules/.lockhash; }; else npm install; fi; exec npm run dev"]
