# 🚀 Ignore Node.js Dependencies
node_modules/

# 🚀 Ignore Next.js Build Output
.next/
.next-e2e/

# 🚀 Ignore Environment Variables
.env
.env.local
.env.production
.env.development
.env.test

# 🚀 Playwright E2E artefacts (specs/config ARE committed; these are not)
/test-results/
/playwright-report/
/e2e/.auth/

# 🚀 Ignore Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
debug.log

# 🚀 Ignore Lock Files (Optional)
package-lock.json
yarn.lock
pnpm-lock.yaml

# 🚀 Ignore VS Code and Editor Config Files
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# 🚀 Ignore Aider AI Files
.aider*

# 🚀 Ignore Output Files
out/
dist/

# 🚀 Ignore PostCSS and Tailwind Cache
.postcssrc
.tailwindcache/

# 🚀 Ignore Public Uploads (Optional)
public/uploads/
.aider*
