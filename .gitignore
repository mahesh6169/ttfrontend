# Node.js dependencies
node_modules/

# Next.js build output
.next/
.next-e2e/
.next-e2e-*/
out/
dist/

# Environment variables
.env
.env.local
.env.production
.env.development
.env.test

# Playwright e2e artefacts (specs/config ARE committed; these are not)
/test-results/
/playwright-report/
/e2e/.auth/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
debug.log

# Other package managers' lock files (npm's package-lock.json IS committed)
yarn.lock
pnpm-lock.yaml

# Editor and OS files
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# AI tool files
.aider*

# PostCSS / Tailwind cache
.postcssrc
.tailwindcache/

# Throwaway design preview pages (local only)
app/preview/
